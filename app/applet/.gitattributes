# Prevent Git LFS from handling gradle-wrapper.jar or .jar files.
# Storing gradle-wrapper.jar in Git LFS causes CI build failures ("Invalid or corrupt jarfile")
# if Git LFS fails to resolve pointer files during clone.
gradle/wrapper/gradle-wrapper.jar -filter -diff -merge binary
*.jar -filter -diff -merge binary

# Mark binary assets to prevent line-ending or encoding corruption
*.png binary
*.so binary
*.keystore binary
*.apk binary
*.aab binary

# Ensure gradlew always uses Unix (LF) line endings
gradlew text eol=lf
